# =====================================================
# CheckoutPRO - Configuração Apache (.htaccess)
# Autor: Rafael Souza - Souza Tech
# Compatível com Apache 2.2+ e 2.4+
# =====================================================

# Habilita RewriteEngine (se disponível)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Garante que o cabeçalho 'Authorization' seja passado para as requisições PHP
    # Essencial para APIs que dependem deste cabeçalho (ex: Mercado Pago)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Redireciona requisições que terminam em '.php' para suas versões sem extensão.
    #    Esta regra aplica-se APENAS a requisições GET para evitar a perda de dados em envios POST.
    #    O redirecionamento é 301 (Permanent) para browsers e SEO.
    RewriteCond %{THE_REQUEST} ^GET
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php([^\ ]*)?\ HTTP/
    RewriteRule ^([^.]+)\.php([^\ ]*)?$ http://%{HTTP_HOST}/$1$2 [R=301,L]

    # 2. Reescreve internamente URLs limpas (sem extensão) para os arquivos .php correspondentes.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)/?$ $1.php [L]

    # 3. Regra "Catch-all": Redireciona para index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# =====================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =====================================================

# Permite acesso aos arquivos necessários PRIMEIRO (prioridade)
<FilesMatch "^(admin_api\.php|process_payment\.php|notification\.php|check_status\.php|checkout\.php|index\.php|admin\.php)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Impede o acesso direto a arquivos sensíveis (Apache 2.2 e 2.4)
<FilesMatch "^(config\.php|\.env|\.htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protege arquivos de log específicos (não todos .txt)
<FilesMatch "^.*\.(log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protege .htaccess e .git
<FilesMatch "^\.ht|^\.git">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# =====================================================
# CONFIGURAÇÕES DE PERFORMANCE E COMPATIBILIDADE
# =====================================================

# Aumenta limites de execução PHP (se permitido pelo servidor)
<IfModule mod_php7.c>
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value post_max_size 50M
    php_value upload_max_filesize 50M
</IfModule>

# Headers de segurança e compatibilidade
<IfModule mod_headers.c>
    # Permite CORS para admin_api.php (necessário para requisições AJAX)
    <FilesMatch "^(admin_api\.php|process_payment\.php|check_status\.php)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        Header set Access-Control-Max-Age "3600"
    </FilesMatch>
    
    # Segurança geral
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    
    # Remove informações do servidor
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# Compressão GZIP (melhora performance)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# =====================================================
# TRATAMENTO DE ERROS
# =====================================================

# Páginas de erro customizadas (opcional)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php

# Desabilita listagem de diretórios
Options -Indexes

# Habilita FollowSymLinks (necessário para mod_rewrite)
Options +FollowSymLinks

# =====================================================
# FIM DA CONFIGURAÇÃO
# =====================================================